# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
# Your deployed URL (e.g. http://localhost:3000 in dev, https://yourdomain.com in prod)
# Used by NextAuth internally AND as the base URL for server-side API calls
NEXTAUTH_URL=""

# ─────────────────────────────────────────────
# AUTH — NextAuth
# ─────────────────────────────────────────────
# Random 32+ char secret → run: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─────────────────────────────────────────────
# DATABASE — MongoDB
# ─────────────────────────────────────────────
# MongoDB connection string
# Local:  mongodb://localhost:27017/growin
# Atlas:  https://cloud.mongodb.com → New Project → Connect → Drivers → copy URI
MONGODB_URI=""

# ─────────────────────────────────────────────
# OAUTH — Google
# ─────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# OAUTH — GitHub
# ─────────────────────────────────────────────
# github.com → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# PAYMENTS — Stripe
# ─────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys → Secret key
STRIPE_SECRET_KEY=""

# dashboard.stripe.com → Developers → Webhooks → Add endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# REAL-TIME — Pusher
# ─────────────────────────────────────────────
# pusher.com → Create App → App Keys
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ─────────────────────────────────────────────
# FILE STORAGE — AWS S3
# ─────────────────────────────────────────────
# aws.amazon.com → IAM → Users → Create user → Attach S3 policy → Access keys
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET_NAME=""

# ─────────────────────────────────────────────
# AI — OpenAI
# ─────────────────────────────────────────────
# platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=""

# ─────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=""

# The "from" address for outgoing emails (must be a verified domain on Resend)
# e.g. noreply@yourdomain.com
EMAIL_FROM=""

# Admin email to receive platform notifications (e.g. status requests)
ADMIN_EMAIL=""
